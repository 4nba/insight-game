{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "insight-game",
  "compatibility_date": "2026-01-01",
  "pages_build_output_dir": ".",
  // Cloudflare Pages: create a KV namespace named INSIGHT_KV and bind it in
  // Settings -> Bindings -> KV namespace (variable name: INSIGHT_KV).
  // Alternatively, uncomment and put the real namespace id here:
  // "kv_namespaces": [{ "binding": "INSIGHT_KV", "id": "<real-namespace-id>" }]
}
